import json
import time

import cv2
import numpy as np
import rclpy

from cv_bridge import CvBridge
from rclpy.node import Node
from sensor_msgs.msg import Image
from std_msgs.msg import String


class BinColorPublisher(Node):

    def __init__(self):
        super().__init__("bin_color_publisher")

        self.bridge = CvBridge()

        self.last_log_time = 0.0
        self.last_result = None

        self.create_subscription(
            Image,
            "/webcam/image_raw",
            self.image_callback,
            10
        )

        self.publisher = self.create_publisher(
            String,
            "/laundry/bin_color_detections",
            10
        )

        self.get_logger().info(
            "BIN Color/Texture Publisher 시작 - 배경 저장 없음"
        )

    def extract_features(self, roi):

        hsv = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2HSV
        )

        lab = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2LAB
        )

        gray = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2GRAY
        )

        h, s, v = np.median(
            hsv.reshape(-1, 3),
            axis=0
        )

        l, a, b = np.median(
            lab.reshape(-1, 3),
            axis=0
        )

        # 표면의 글자/그림/무늬 정도
        texture = float(
            cv2.Laplacian(
                gray,
                cv2.CV_64F
            ).var()
        )

        edges = cv2.Canny(
            gray,
            60,
            140
        )

        edge_density = float(
            np.count_nonzero(edges)
            / edges.size
        )

        return (
            float(h),
            float(s),
            float(v),
            float(l),
            float(a),
            float(b),
            texture,
            edge_density
        )

    def classify_bin(self, features):

        (
            h, s, v,
            l, a, b,
            texture,
            edge_density
        ) = features

        # =========================
        # DARK 빨래통
        # 실제 촬영값:
        # HSV 약 (16, 111, 100)
        # =========================

        dark_color = (
            8 <= h <= 30
            and
            55 <= s <= 180
            and
            45 <= v <= 170
        )

        # =========================
        # LIGHT 빨래통
        # 실제 촬영값:
        # HSV 약 (20, 14, 104)
        # LAB 약 (105, 130, 129)
        # =========================

        light_color = (
            s <= 45
            and
            65 <= l <= 165
            and
            120 <= a <= 142
            and
            118 <= b <= 142
        )

        # Hello Kitty 글자/그림 같은
        # 표면 텍스처 특징
        has_texture = (
            texture >= 20.0
            or
            edge_density >= 0.015
        )

        if dark_color:
            return "BIN_B", "DARK"

        if light_color and has_texture:
            return "BIN_A", "LIGHT"

        return None, None

    def image_callback(self, msg):

        frame = self.bridge.imgmsg_to_cv2(
            msg,
            desired_encoding="bgr8"
        )

        frame_h, frame_w = frame.shape[:2]

        # =========================
        # 화면 중앙 영역 검사
        # =========================

        roi_w = int(
            frame_w * 0.70
        )

        roi_h = int(
            frame_h * 0.60
        )

        x1 = (
            frame_w - roi_w
        ) // 2

        y1 = (
            frame_h - roi_h
        ) // 2

        x2 = x1 + roi_w
        y2 = y1 + roi_h

        roi = frame[
            y1:y2,
            x1:x2
        ]

        if roi.size == 0:
            return

        features = self.extract_features(
            roi
        )

        (
            bin_name,
            laundry_type
        ) = self.classify_bin(
            features
        )

        (
            h, s, v,
            l, a, b,
            texture,
            edge_density
        ) = features

        now = time.time()

        # =========================
        # 아직 어떤 통인지 확정 안 됨
        # =========================

        if bin_name is None:

            if (
                now - self.last_log_time
                >= 1.0
            ):

                self.get_logger().info(
                    "BIN 미확정 "
                    f"HSV=({h:.0f},{s:.0f},{v:.0f}) "
                    f"LAB=({l:.0f},{a:.0f},{b:.0f}) "
                    f"texture={texture:.1f} "
                    f"edge={edge_density:.3f}"
                )

                self.last_log_time = now

            return

        # =========================
        # BIN 위치
        # =========================

        center = [
            (x1 + x2) // 2,
            (y1 + y2) // 2
        ]

        bbox = [
            x1,
            y1,
            roi_w,
            roi_h
        ]

        result = {

            "bin": bin_name,

            "laundry_type":
                laundry_type,

            "center":
                center,

            "bbox":
                bbox,

            "source":
                "COLOR_TEXTURE",

            "hsv": [
                round(h, 1),
                round(s, 1),
                round(v, 1)
            ],

            "lab": [
                round(l, 1),
                round(a, 1),
                round(b, 1)
            ],

            "texture":
                round(texture, 1),

            "edge_density":
                round(
                    edge_density,
                    4
                )
        }

        message = String()

        message.data = json.dumps(
            result,
            ensure_ascii=False
        )

        self.publisher.publish(
            message
        )

        if (
            result != self.last_result
            or
            now - self.last_log_time
            >= 1.0
        ):

            self.get_logger().info(
                f"{laundry_type} BIN -> "
                f"{bin_name} "
                f"HSV=({h:.0f},{s:.0f},{v:.0f}) "
                f"texture={texture:.1f} "
                f"edge={edge_density:.3f}"
            )

            self.last_log_time = now
            self.last_result = result


def main(args=None):

    rclpy.init(
        args=args
    )

    node = BinColorPublisher()

    try:

        rclpy.spin(
            node
        )

    except KeyboardInterrupt:

        pass

    finally:

        node.destroy_node()

        if rclpy.ok():

            rclpy.shutdown()


if __name__ == "__main__":
    main()
