import json
import time

import cv2
import pytesseract
import rclpy

from cv_bridge import CvBridge
from pytesseract import TesseractError, Output
from rclpy.node import Node
from sensor_msgs.msg import Image
from std_msgs.msg import String


OCR_SCALE = 3.0
REQUIRED_CONFIRMATIONS = 2


class BinOCRPublisher(Node):

    def __init__(self):

        super().__init__("bin_ocr_publisher")

        self.bridge = CvBridge()

        self.last_ocr_time = 0.0
        self.ocr_interval = 1.0

        # 이미 최종 등록된 BIN
        self.registered_bins = set()

        # 연속 인식 확인용
        self.last_candidate = None
        self.confirm_count = 0

        # BIN_A/B 등록 완료 후 종료용
        self.finish_timer = None

        self.create_subscription(
            Image,
            "/webcam/image_raw",
            self.image_callback,
            10
        )

        self.publisher = self.create_publisher(
            String,
            "/laundry/bin_detections",
            10
        )

        self.get_logger().info(
            "BIN OCR Publisher 시작"
        )

    def image_callback(self, msg):

        now = time.time()

        if (
            now - self.last_ocr_time
            < self.ocr_interval
        ):
            return

        self.last_ocr_time = now

        frame = self.bridge.imgmsg_to_cv2(
            msg,
            desired_encoding="bgr8"
        )

        height, width = frame.shape[:2]

        # =========================
        # 중앙 OCR 영역
        # =========================

        roi_width = int(
            width * 0.70
        )

        roi_height = int(
            height * 0.60
        )

        x1 = (
            width - roi_width
        ) // 2

        y1 = (
            height - roi_height
        ) // 2

        x2 = x1 + roi_width
        y2 = y1 + roi_height

        roi = frame[
            y1:y2,
            x1:x2
        ]

        if roi.size == 0:
            return

        # =========================
        # OCR용 확대
        # =========================

        roi = cv2.resize(
            roi,
            None,
            fx=OCR_SCALE,
            fy=OCR_SCALE,
            interpolation=cv2.INTER_CUBIC
        )

        gray = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2GRAY
        )

        gray = cv2.GaussianBlur(
            gray,
            (3, 3),
            0
        )

        _, binary = cv2.threshold(
            gray,
            0,
            255,
            cv2.THRESH_BINARY + cv2.THRESH_OTSU
        )

        config = (
            "--psm 7 "
            "-l eng "
            "-c tessedit_char_whitelist=ABCDEFGHIJKLMNOPQRSTUVWXYZ_"
        )

        # =========================
        # Tesseract
        # =========================

        try:
            ocr_data = pytesseract.image_to_data(
                binary,
                config=config,
                output_type=Output.DICT
            )

            words = []

            for item in ocr_data["text"]:
                item = item.strip()

                if item:
                    words.append(item)

            text = " ".join(words)

        except TesseractError:
            return

        except Exception:
            return

        cleaned = (
            text
            .upper()
            .replace(" ", "")
            .replace("\n", "")
            .replace("\r", "")
        )

        # =========================
        # A/B 포함 판정
        # =========================

        has_a = "A" in cleaned
        has_b = "B" in cleaned

        candidate = None
        candidate_center = None
        candidate_bbox = None

        # A와 B가 동시에 들어간 결과는 애매하므로 무시
        if has_a and not has_b:
            candidate = "BIN_A"

        elif has_b and not has_a:
            candidate = "BIN_B"

        # =========================
        # OCR 글자 위치 찾기
        # =========================

        target_letter = None

        if candidate == "BIN_A":
            target_letter = "A"

        elif candidate == "BIN_B":
            target_letter = "B"

        if target_letter is not None:

            for i, word in enumerate(
                ocr_data["text"]
            ):

                word = (
                    word
                    .upper()
                    .replace(" ", "")
                    .strip()
                )

                if target_letter not in word:
                    continue

                sx = int(
                    ocr_data["left"][i]
                )

                sy = int(
                    ocr_data["top"][i]
                )

                sw = int(
                    ocr_data["width"][i]
                )

                sh = int(
                    ocr_data["height"][i]
                )

                # 확대된 OCR 좌표를 원본 카메라 좌표로 환산
                bx = x1 + int(
                    sx / OCR_SCALE
                )

                by = y1 + int(
                    sy / OCR_SCALE
                )

                bw = max(
                    1,
                    int(sw / OCR_SCALE)
                )

                bh = max(
                    1,
                    int(sh / OCR_SCALE)
                )

                cx = bx + bw // 2
                cy = by + bh // 2

                candidate_center = [
                    cx,
                    cy
                ]

                candidate_bbox = [
                    bx,
                    by,
                    bw,
                    bh
                ]

                break

        # =========================
        # 연속 확인
        # =========================

        if candidate is None:

            self.last_candidate = None
            self.confirm_count = 0

        elif candidate in self.registered_bins:

            # 이미 등록된 BIN
            # 다시 로그를 찍거나 재등록하지 않음
            self.last_candidate = None
            self.confirm_count = 0

        else:

            if candidate == self.last_candidate:

                self.confirm_count += 1

            else:

                self.last_candidate = candidate
                self.confirm_count = 1

            if (
                self.confirm_count
                >= REQUIRED_CONFIRMATIONS
            ):

                self.registered_bins.add(
                    candidate
                )

                # 등록 로그는 BIN당 딱 한 번
                self.get_logger().info(
                    f"BIN 등록: {candidate} "
                    f"center={candidate_center} "
                    f"bbox={candidate_bbox}"
                )

                self.last_candidate = None
                self.confirm_count = 0

        # =========================
        # 현재 상태 발행
        # =========================

        result = {
            "raw_text": cleaned,
            "candidate": candidate,
            "confirm_count": self.confirm_count,
            "center": candidate_center,
            "bbox": candidate_bbox,
            "bins": sorted(
                self.registered_bins
            )
        }

        message = String()

        message.data = json.dumps(
            result,
            ensure_ascii=False
        )

        self.publisher.publish(
            message
        )

        # BIN_A와 BIN_B가 모두 등록되면
        # 마지막 결과를 발행한 뒤 잠시 후 OCR 종료
        if (
            "BIN_A" in self.registered_bins
            and
            "BIN_B" in self.registered_bins
            and
            self.finish_timer is None
        ):
            self.finish_timer = self.create_timer(
                0.5,
                self.finish_ocr
            )

    def finish_ocr(self):

        self.get_logger().info(
            "BIN_A / BIN_B 등록 완료"
        )

        if rclpy.ok():
            rclpy.shutdown()


def main(args=None):

    rclpy.init(
        args=args
    )

    node = BinOCRPublisher()

    try:
        rclpy.spin(
            node
        )

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
