<?xml version="1.0"?>

<package format="3">

  <name>laundry_sorting</name>

  <version>0.0.1</version>

  <description>
    Laundry sorting assistant package
  </description>

  <maintainer email="rokey@todo.todo">
    rokey
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>
    ament_python
  </buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <!-- V + L 통합 launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>voice_processing</exec_depend>

  <export>

    <build_type>
      ament_python
    </build_type>

  </export>

</package>
