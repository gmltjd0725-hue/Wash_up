import json
import time

import cv2
import numpy as np
import pytesseract
import rclpy

from cv_bridge import CvBridge
from rclpy.node import Node
from sensor_msgs.msg import Image
from std_msgs.msg import String


PROCESS_INTERVAL = 1.0


class BinColorPublisher(Node):

    def __init__(self):

        super().__init__("bin_color_publisher")

        self.bridge = CvBridge()

        self.last_process_time = 0.0
        self.last_signature = None

        self.create_subscription(
            Image,
            "/webcam/image_raw",
            self.image_callback,
            10
        )

        self.publisher = self.create_publisher(
            String,
            "/laundry/bin_color_detections",
            10
        )

        self.get_logger().info(
            "BIN A/B + COLOR Publisher 시작"
        )

        self.get_logger().info(
            "A=BIN_A/LIGHT/연한분홍, "
            "B=BIN_B/DARK/갈색"
        )

    # ============================================================
    # 흰 종이 A/B 라벨 찾기
    # ============================================================

    def find_label(self, roi):

        hsv = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2HSV
        )

        # 흰 종이 후보
        mask = cv2.inRange(
            hsv,
            np.array([0, 0, 165]),
            np.array([179, 90, 255])
        )

        kernel = np.ones(
            (5, 5),
            np.uint8
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_CLOSE,
            kernel,
            iterations=2
        )

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        roi_h, roi_w = roi.shape[:2]

        min_area = (
            roi_w
            * roi_h
            * 0.015
        )

        candidates = []

        for contour in contours:

            area = cv2.contourArea(
                contour
            )

            if area < min_area:
                continue

            x, y, w, h = cv2.boundingRect(
                contour
            )

            if w < 35 or h < 35:
                continue

            ratio = w / float(h)

            if ratio < 0.45 or ratio > 2.2:
                continue

            candidates.append(
                (
                    area,
                    x,
                    y,
                    w,
                    h
                )
            )

        if not candidates:
            return None

        candidates.sort(
            reverse=True
        )

        _, x, y, w, h = candidates[0]

        return (
            x,
            y,
            w,
            h
        )

    # ============================================================
    # A / B OCR
    # ============================================================

    def ocr_once(
        self,
        image,
        config
    ):

        try:

            text = pytesseract.image_to_string(
                image,
                config=config
            )

        except Exception:
            return None

        cleaned = (
            text
            .upper()
            .replace(" ", "")
            .replace("\n", "")
            .replace("\r", "")
        )

        has_a = "A" in cleaned
        has_b = "B" in cleaned

        if has_a and not has_b:
            return "A"

        if has_b and not has_a:
            return "B"

        return None

    def detect_letter(
        self,
        label_roi
    ):

        if label_roi is None:
            return None

        if label_roi.size == 0:
            return None

        enlarged = cv2.resize(
            label_roi,
            None,
            fx=3.5,
            fy=3.5,
            interpolation=cv2.INTER_CUBIC
        )

        gray = cv2.cvtColor(
            enlarged,
            cv2.COLOR_BGR2GRAY
        )

        gray = cv2.GaussianBlur(
            gray,
            (3, 3),
            0
        )

        _, binary = cv2.threshold(
            gray,
            0,
            255,
            cv2.THRESH_BINARY
            + cv2.THRESH_OTSU
        )

        votes = []

        # 큰 단일 문자 A/B
        result = self.ocr_once(
            binary,
            "--psm 10 -l eng "
            "-c tessedit_char_whitelist=AB"
        )

        if result is not None:
            votes.append(result)

        result = self.ocr_once(
            gray,
            "--psm 10 -l eng "
            "-c tessedit_char_whitelist=AB"
        )

        if result is not None:
            votes.append(result)

        # 기존처럼 BM, NB, ALA 등에
        # A/B 한 글자라도 들어가면 보조 판정
        result = self.ocr_once(
            binary,
            "--psm 7 -l eng "
            "-c tessedit_char_whitelist="
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        )

        if result is not None:
            votes.append(result)

        a_count = votes.count("A")
        b_count = votes.count("B")

        if (
            a_count >= 1
            and
            a_count > b_count
        ):
            return "A"

        if (
            b_count >= 1
            and
            b_count > a_count
        ):
            return "B"

        return None

    # ============================================================
    # 빨래통 본체 색상 측정
    # ============================================================

    def measure_bin_color(
        self,
        roi,
        label_bbox
    ):

        hsv = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2HSV
        )

        lab = cv2.cvtColor(
            roi,
            cv2.COLOR_BGR2LAB
        )

        mask = np.full(
            roi.shape[:2],
            255,
            dtype=np.uint8
        )

        # 중앙의 흰 A/B 종이는
        # 빨래통 색상 계산에서 제외
        if label_bbox is not None:

            x, y, w, h = label_bbox

            pad = 8

            x1 = max(
                0,
                x - pad
            )

            y1 = max(
                0,
                y - pad
            )

            x2 = min(
                roi.shape[1],
                x + w + pad
            )

            y2 = min(
                roi.shape[0],
                y + h + pad
            )

            mask[
                y1:y2,
                x1:x2
            ] = 0

        # 흰 종이/강한 반사광 추가 제거
        # 아주 순수한 흰색/강한 반사광만 제외
        # 연한 분홍색 빨래통은 살려둔다.
        white_pixels = (
            (hsv[:, :, 1] < 10)
            &
            (hsv[:, :, 2] > 248)
        )

        mask[
            white_pixels
        ] = 0

        valid = (
            mask == 255
        )

        if (
            np.count_nonzero(valid)
            < 1000
        ):
            return None

        hsv_pixels = hsv[
            valid
        ]

        lab_pixels = lab[
            valid
        ]

        H, S, V = np.median(
            hsv_pixels,
            axis=0
        )

        L, A, B = np.median(
            lab_pixels,
            axis=0
        )

        return (
            float(H),
            float(S),
            float(V),
            float(L),
            float(A),
            float(B)
        )

    # ============================================================
    # 연한 분홍 / 갈색 비교
    #
    # 기존 실제 촬영값 기준:
    #
    # DARK 갈색:
    # HSV ≈ 16,111,100
    # LAB ≈ 90,133,145
    #
    # LIGHT 연한 계열:
    # HSV ≈ 20,14,104
    # LAB ≈ 105,130,129
    # ============================================================

    def classify_color(
        self,
        features
    ):

        if features is None:
            return "UNKNOWN", None, None

        H, S, V, L, A, B = features

        dark_score = (
            abs(S - 111.0) / 55.0
            +
            abs(V - 100.0) / 65.0
            +
            abs(L - 90.0) / 55.0
            +
            abs(A - 133.0) / 25.0
            +
            abs(B - 145.0) / 20.0
        )

        light_score = (
            abs(S - 14.0) / 45.0
            +
            abs(V - 104.0) / 65.0
            +
            abs(L - 105.0) / 55.0
            +
            abs(A - 130.0) / 25.0
            +
            abs(B - 129.0) / 20.0
        )

        # 두 기준 차이가 너무 작으면
        # 억지로 색을 확정하지 않음.
        margin = abs(
            dark_score
            - light_score
        )

        if margin < 0.45:

            return (
                "UNKNOWN",
                dark_score,
                light_score
            )

        if dark_score < light_score:

            return (
                "BROWN",
                dark_score,
                light_score
            )

        return (
            "LIGHT_PINK",
            dark_score,
            light_score
        )

    # ============================================================
    # A/B + 색상 교차검증
    # ============================================================

    def verify(
        self,
        letter,
        color
    ):

        if (
            letter == "A"
            and
            color == "LIGHT_PINK"
        ):

            return (
                "BIN_A",
                "LIGHT",
                "CONFIRMED"
            )

        if (
            letter == "B"
            and
            color == "BROWN"
        ):

            return (
                "BIN_B",
                "DARK",
                "CONFIRMED"
            )

        if (
            letter == "A"
            and
            color == "BROWN"
        ):

            return (
                None,
                None,
                "CONFLICT"
            )

        if (
            letter == "B"
            and
            color == "LIGHT_PINK"
        ):

            return (
                None,
                None,
                "CONFLICT"
            )

        if (
            letter is not None
            and
            color == "UNKNOWN"
        ):

            return (
                None,
                None,
                "WAIT_COLOR"
            )

        if (
            letter is None
            and
            color != "UNKNOWN"
        ):

            return (
                None,
                None,
                "WAIT_OCR"
            )

        return (
            None,
            None,
            "UNKNOWN"
        )

    # ============================================================
    # IMAGE
    # ============================================================

    def image_callback(
        self,
        msg
    ):

        now = time.time()

        if (
            now
            - self.last_process_time
            < PROCESS_INTERVAL
        ):
            return

        self.last_process_time = now

        frame = self.bridge.imgmsg_to_cv2(
            msg,
            desired_encoding="bgr8"
        )

        frame_h, frame_w = frame.shape[:2]

        roi_w = int(
            frame_w * 0.70
        )

        roi_h = int(
            frame_h * 0.60
        )

        x1 = (
            frame_w
            - roi_w
        ) // 2

        y1 = (
            frame_h
            - roi_h
        ) // 2

        x2 = x1 + roi_w
        y2 = y1 + roi_h

        roi = frame[
            y1:y2,
            x1:x2
        ]

        if roi.size == 0:
            return

        label_bbox_local = self.find_label(
            roi
        )

        # 흰 라벨을 못 찾았을 경우에도
        # 중앙 영역에서 OCR 한 번 시도
        if label_bbox_local is not None:

            lx, ly, lw, lh = (
                label_bbox_local
            )

            label_roi = roi[
                ly:ly + lh,
                lx:lx + lw
            ]

            label_bbox = [
                x1 + lx,
                y1 + ly,
                lw,
                lh
            ]

        else:

            fallback_w = int(
                roi_w * 0.55
            )

            fallback_h = int(
                roi_h * 0.55
            )

            fx = (
                roi_w
                - fallback_w
            ) // 2

            fy = (
                roi_h
                - fallback_h
            ) // 2

            label_roi = roi[
                fy:fy + fallback_h,
                fx:fx + fallback_w
            ]

            label_bbox = None

        letter = self.detect_letter(
            label_roi
        )

        features = self.measure_bin_color(
            roi,
            label_bbox_local
        )

        (
            color,
            dark_score,
            light_score
        ) = self.classify_color(
            features
        )

        (
            bin_name,
            laundry_type,
            status
        ) = self.verify(
            letter,
            color
        )

        if features is not None:

            H, S, V, L, A, B = features

            hsv_result = [
                round(H, 1),
                round(S, 1),
                round(V, 1)
            ]

            lab_result = [
                round(L, 1),
                round(A, 1),
                round(B, 1)
            ]

        else:

            hsv_result = None
            lab_result = None

        result = {

            "ocr_letter":
                letter,

            "color":
                color,

            "bin":
                bin_name,

            "laundry_type":
                laundry_type,

            "status":
                status,

            "roi_bbox": [
                x1,
                y1,
                roi_w,
                roi_h
            ],

            "label_bbox":
                label_bbox,

            "center": (
                [
                    (
                        label_bbox[0]
                        + label_bbox[2] // 2
                    ),
                    (
                        label_bbox[1]
                        + label_bbox[3] // 2
                    )
                ]
                if label_bbox is not None
                else None
            ),

            "bbox":
                label_bbox,

            "hsv":
                hsv_result,

            "lab":
                lab_result,

            "dark_score": (
                round(
                    dark_score,
                    2
                )
                if dark_score is not None
                else None
            ),

            "light_score": (
                round(
                    light_score,
                    2
                )
                if light_score is not None
                else None
            ),

            "source":
                "OCR_COLOR_VERIFY"
        }

        message = String()

        message.data = json.dumps(
            result,
            ensure_ascii=False
        )

        self.publisher.publish(
            message
        )

        # 판정이 바뀌었을 때만 로그 출력
        signature = (
            letter,
            color,
            bin_name,
            status
        )

        if (
            signature
            != self.last_signature
        ):

            self.get_logger().info(
                f"OCR={letter or '-'} | "
                f"COLOR={color} | "
                f"RESULT={bin_name or '-'} | "
                f"STATUS={status}"
            )

            if features is not None:

                self.get_logger().info(
                    f"HSV={hsv_result} "
                    f"LAB={lab_result} "
                    f"D={dark_score:.2f} "
                    f"L={light_score:.2f}"
                )

            self.last_signature = (
                signature
            )


def main(args=None):

    rclpy.init(
        args=args
    )

    node = BinColorPublisher()

    try:

        rclpy.spin(
            node
        )

    except KeyboardInterrupt:

        pass

    finally:

        node.destroy_node()

        if rclpy.ok():

            rclpy.shutdown()


if __name__ == "__main__":
    main()
